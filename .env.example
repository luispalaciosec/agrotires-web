# Public URL of the site. Production value: https://agrotiresusa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until owners approve launch: controls noindex, robots.txt and sitemap.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Backend. With STORE_DRIVER unset, the APIs answer 503 instead of losing data.
# "local" writes to a file and is for development only; it is replaced by the database.
STORE_DRIVER=local

# PayPal. Credentials are server-only: never prefix them with NEXT_PUBLIC_.
PAYMENTS_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Admin panel access. Generate both with: npm run admin:setup
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
