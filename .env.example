# Public URL of the site. Production value: https://agrotiresusa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until owners approve launch: controls noindex, robots.txt and sitemap.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Supabase. Never add the NEXT_PUBLIC_ prefix to the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Development without Supabase: "local" writes to a file. Never use it on Vercel.
# With neither configured, the APIs answer 503 instead of losing data.
# STORE_DRIVER=local

# PayPal. Credentials are server-only: never prefix them with NEXT_PUBLIC_.
PAYMENTS_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Email through the Google Workspace mailbox, using an app password (no DNS changes needed).
# Without SMTP_USER and SMTP_PASS the store still works and sends no email.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (smtp.gmail.com), SMTP_PORT (465), EMAIL_FROM and EMAIL_TEAM (contact@agrotiresusa.com)

# Panel access without Supabase only. Generate both with: npm run admin:setup
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
